pipeline {
	agent {
		label 'ubuntu-latest'
	}

	triggers {
		cron('H 5 * * 0')
	}

	options {
		buildDiscarder(logRotator(numToKeepStr: '5'))
		disableConcurrentBuilds()
		skipDefaultCheckout false
	}

	tools {
		maven 'apache-maven-latest'
		jdk 'openjdk-jdk17-latest'
	}

	environment {
		BUILD_TIMESTAMP = sh(returnStdout: true, script: 'date +%Y%m%d%H%M').trim()
	}
	
	parameters {
		choice(
			name: 'OCL_REPO',
			choices: ['nightlyLatest', 'milestoneLatest', 'releaseLatest', 'branchLatest', 'reload'],
			description: '''
The repo to be tested or reload -- to reload the parameter definitions from GIT and bypass testing
'''		)
		
		string(
			name: 'BRANCH_NAME',
			defaultValue: 'master',
			description: 'Specify the branch to be tested for example: (master).'
		)
	}

	stages {
		//
		//	Set BUILD_TYPE in the Jenkins job description.
		//
		stage('Display Parameters') {
			steps {
				script {
					env.BRANCH_NAME = params.BRANCH_NAME
					env.OCL_REPO = params.OCL_REPO
					def description = """
BRANCH_NAME=${env.BRANCH_NAME}
OCL_REPO=${env.OCL_REPO}
""".trim()
					echo description
					currentBuild.description = description.replace("\n", "<br/>")
				}
			}
		}
		//
		//	Fetch the build under test
		//
		stage('Copy Artifacts') {
			when {
				expression { return params.OCL_REPO != 'reload' && currentBuild.getPreviousBuild() != null }
			}
			steps {
				copyArtifacts(projectName: 'ocl-master', filter: 'releng/org.eclipse.ocl.releng.build-site/target/repository/**/*')
			}
		}
		//
		//	Do the standalone Ecore test.
		//
		stage('Test-Ecore') {
			when {
				expression { return params.OCL_REPO != 'reload' && currentBuild.getPreviousBuild() != null }
			}
			steps {
				wrap([$class: 'Xvnc', takeScreenshot: false, useXauthority: true]) {
					sh '''
						mvn	\
							-f tests/org.eclipse.ocl.standalone.ecore.tests/pomGenerateLocalTarget.xml \
							--no-transfer-progress \
							--show-version \
							generate-sources
						mvn	\
							-f tests/org.eclipse.ocl.standalone.ecore.tests/pom.xml \
							--no-transfer-progress \
							--show-version \
							clean \
							test \
							-Plocal \
							--global-toolchains toolchains.xml
						'''
				}
				archiveArtifacts artifacts: 'tests/org.eclipse.ocl.standalone.ecore.tests/target/*-reports/**/*.xml'
			}
		}
		//
		//	Do the standalone UML test.
		//
		stage('Test-UML') {
			when {
				expression { return params.OCL_REPO != 'reload' && currentBuild.getPreviousBuild() != null }
			}
			steps {
				wrap([$class: 'Xvnc', takeScreenshot: false, useXauthority: true]) {
					sh '''
						mvn	\
							-f tests/org.eclipse.ocl.standalone.uml.tests/pomGenerateLocalTarget.xml \
							--no-transfer-progress \
							--show-version \
							generate-sources
						mvn	\
							-f tests/org.eclipse.ocl.standalone.uml.tests/pom.xml \
							--no-transfer-progress \
							--show-version \
							-Dorg.eclipse.equinox.p2.transport.ecf.retry=100 \
							clean \
							test \
							-Plocal \
							--global-toolchains toolchains.xml
						'''
				}
				archiveArtifacts artifacts: 'tests/org.eclipse.ocl.standalone.uml.tests/target/*-reports/**/*.xml'
			}
		}
	}
	
	post {
		failure {
			mail to: 'ed@willink.me.uk', subject: "[OCL CI] Build Failure ${currentBuild.fullDisplayName}", mimeType: 'text/plain',
body: "Project: ${env.JOB_NAME}\n\
Build Number: ${env.BUILD_NUMBER}\n\
Build URL: <${env.BUILD_URL}>\n\
Console: <${env.BUILD_URL}console>"
			archiveArtifacts allowEmptyArchive: true, artifacts: '**'
		}

		fixed {
			mail to: 'ed@willink.me.uk', subject: "[OCL CI] Back to normal ${currentBuild.fullDisplayName}", mimeType: 'text/plain',
body: "Project: ${env.JOB_NAME}\n\
Build Number: ${env.BUILD_NUMBER}\n\
Build URL: <${env.BUILD_URL}>\n\
Console: <${env.BUILD_URL}console>"
		}

		always {
			junit allowEmptyResults: params.OCL_REPO == 'reload' || currentBuild.getPreviousBuild() == null, testResults: '**/*-reports/**/*.xml'		
		}

//		cleanup {
//			deleteDir()
//		}
	}
}
