pipeline {
	agent {
		label 'ubuntu-latest'
	}

	triggers {
		cron('H 7 * * 0')
	}

	options {
		buildDiscarder(logRotator(numToKeepStr: '5'))
		disableConcurrentBuilds()
		skipDefaultCheckout false
	}

	tools {
		maven 'apache-maven-latest'
		jdk 'openjdk-jdk21-latest'
	}

	environment {
		BUILD_TIMESTAMP = sh(returnStdout: true, script: 'date +%Y%m%d%H%M').trim()
	}
	
	parameters {
		choice(
			name: 'OCL_REPO',
			choices: ['nightlyLatest', 'milestoneLatest', 'releaseLatest', 'branchLatest', 'reload'],
			description: '''
The repo to be tested:
<ul>
<li> nightlyLatest - the most recent nightly download
<li> milestoneLatest - the most recent milestone download
<li> releaseLatest - the most recent release download
<li> branchLatest - the most recent ocl-branch build download
<li> reload -- to reload the parameter definitions from GIT and bypass testing
</ul>				'''
		)
		
		
		string(
			name: 'BRANCH_NAME',
			defaultValue: 'master',
			description: 'Specify the branch to be tested for example: (master).'
		)
	}

	stages {
		//
		//	Set parameters in the Jenkins job description.
		//
		stage('Display') {
			steps {
				script {
					env.BRANCH_NAME = params.BRANCH_NAME
					echo "${params.BRANCH_NAME}: ${params.OCL_REPO}"
					currentBuild.description = "${params.BRANCH_NAME}: ${params.OCL_REPO}"
				}
			}
		}
		//
		//	Do the codegen tests.
		//
		stage('Test') {
			when {
				expression { return params.OCL_REPO != 'reload' && currentBuild.getPreviousBuild() != null }
			}
			steps {
				wrap([$class: 'Xvnc', takeScreenshot: false, useXauthority: true]) {
					sh """
						mvn \
							-f tests/org.eclipse.ocl.codegen.tests/pom.xml \
							--no-transfer-progress \
							--show-version \
							clean \
							verify \
							-P${OCL_REPO} \
							--global-toolchains toolchains.xml
						"""
				}
				archiveArtifacts allowEmptyArchive: true, artifacts: "tests/org.eclipse.ocl.codegen.tests/target/surefire-reports/**/*.xml"
			}
		}
	}

	post {
		failure {
			mail to: 'ed@willink.me.uk', subject: "[OCL CI] Build Failure ${currentBuild.fullDisplayName}",
				mimeType: 'text/plain', body: "<${env.BUILD_URL}console>"
			archiveArtifacts allowEmptyArchive: true, artifacts: '**'
		}

		fixed {
			mail to: 'ed@willink.me.uk', subject: "[OCL CI] Back to normal ${currentBuild.fullDisplayName}",
				mimeType: 'text/plain', body: "<${env.BUILD_URL}console>"
		}

		always {
			junit allowEmptyResults: params.OCL_REPO == 'reload' || currentBuild.getPreviousBuild() == null, testResults: 'tests/org.eclipse.ocl.codegen.tests/target/surefire-reports/**/*.xml'		
		}
	}
}
