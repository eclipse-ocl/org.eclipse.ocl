<project default="local.target" basedir=".">
	<property name="rawRepositoryPath" value="file:${ant.file}/../../../releng/org.eclipse.ocl.releng.build-site/target/repository" />
	
	<target name="local.target">
		<echo message="${rawRepositoryPath}" file="normalizingPropertiesFile" />
		<loadfile property="normalizedRepositoryPath" srcFile="normalizingPropertiesFile">
			<filterchain>
				<tokenfilter>
					<replaceregex pattern="\\" replace="/" flags="g" />
				</tokenfilter>
			</filterchain>
		</loadfile>
		<delete file="normalizingPropertiesFile" />
		<echo message="normalizedRepositoryPath = ${normalizedRepositoryPath}" />	
		<copy file="targetPlatforms/templateLocal.target" toFile="targetPlatforms/local.target" overwrite="true">
			<filterset>
				<filter token="repository" value="${normalizedRepositoryPath}"/>
			</filterset>
		</copy>
	</target>
</project>
