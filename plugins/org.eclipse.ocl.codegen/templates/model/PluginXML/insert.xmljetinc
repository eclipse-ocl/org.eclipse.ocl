<%if (hasKey && !org.eclipse.ocl.codegen.oclinecore.OCLinEcoreGenModelGeneratorAdapter.useDelegates(genModel)) {%>
 <%for (GenPackage genPackage : genModel.getAllGenPackagesWithClassifiers()) {%>
 <%if (org.eclipse.ocl.codegen.oclinecore.OCLinEcoreGenModelGeneratorAdapter.hasDelegates(genPackage)) {%>
   <extension point="org.eclipse.ocl.pivot.complete_package_id">
      <!-- @generated <%=key%> -->
      <%if (org.eclipse.ocl.codegen.oclinecore.OCLinEcoreGenModelGeneratorAdapter.isMetamodel(genPackage)) {%>
      <mapping completePackageId="$metamodel$" aspect="metamodel"
      <%}%>
      <%else if (org.eclipse.ocl.codegen.oclinecore.OCLinEcoreGenModelGeneratorAdapter.isLibrary(genPackage)) {%>
      <mapping completePackageId="$metamodel$" aspect="library"
      <%}%>
      <%else {%>
      <mapping
      <%}%>
         packageURI="<%=genPackage.getNSURI()%>"
         class="<%=genPackage.getQualifiedPackageName()%>.<%=genPackage.getPrefix()%>Tables$Descriptor"/>
   </extension>
   <%}%>
 <%}%>
<%}%>
