    <eOperations name="_ne_" lowerBound="1" eType="#//Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;True if oclText[self] is a different object from object2. Infix operator.&#xA;"/>
