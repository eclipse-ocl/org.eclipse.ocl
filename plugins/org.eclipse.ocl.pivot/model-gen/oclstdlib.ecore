    <eOperations name="oclLog" lowerBound="1" eType="#//OclSelf">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;Evaluates to the self, with the side effect of generating a log message comprising self.&#xA;"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="class" value="org.eclipse.ocl.pivot.library.oclany.OclAnyOclLogOperation"/>
