      eSuperTypes="#T-ocl-OclElement"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Precedence" name="Precedence" eSuperTypes="#T-ocl-NamedElement">
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Precedence-associativity" name="associativity" eType="#T-ocl-AssociativityKind"
        defaultValueLiteral="left"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-PrimitiveCompletePackage" name="PrimitiveCompletePackage" eSuperTypes="#T-ocl-CompletePackage">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The PrimitiveCompletePackage comprises each CompleteClass.for which a namespace is meaningless.&#xA;That is not only PrimitiveTypes but AnyType, InvalidType, VoidType, WildcardType and unpecialized CollectionType and MapType. &#xA;It is a root CompletePackage and so has no distinctive parent.&#xA;All explicit PrimitiveType classes are folded into the PrimitiveCompletePackage.&#xA;Classes that overlays of the OCLstdlib PrimitiveType classes are also folded into the PrimitiveCompletePackage."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-PrimitiveLiteralExp" name="PrimitiveLiteralExp" eSuperTypes="#T-ocl-LiteralExp"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-PrimitiveType" name="PrimitiveType" eSuperTypes="#T-ocl-DataType">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A PrimitiveType defines a predefined DataType, without any substructure. A PrimitiveType may have an algebra and operations defined outside of UML, for example, mathematically."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-PrimitiveType-coercions" name="coercions" upperBound="-1" eType="#T-ocl-Operation"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Profile" name="Profile" eSuperTypes="#T-ocl-Package">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A profile defines limited extensions to a reference metamodel with the purpose of adapting the metamodel to a specific platform or domain."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Profile-profileApplications" name="profileApplications" ordered="false"
        upperBound="-1" eType="#T-ocl-ProfileApplication" resolveProxies="false" eOpposite="#F-ocl-ProfileApplication-appliedProfile">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-ProfileApplication" name="ProfileApplication" eSuperTypes="#T-ocl-Element">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A profile application is used to show which profiles have been applied to a package."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-ProfileApplication-appliedProfile" name="appliedProfile" lowerBound="1"
        eType="#T-ocl-Profile" resolveProxies="false" eOpposite="#F-ocl-Profile-profileApplications">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="References the Profiles that are applied to a Package through this ProfileApplication."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-ProfileApplication-isStrict" name="isStrict" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specifies that the Profile filtering rules for the metaclasses of the referenced metamodel shall be strictly applied."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-ProfileApplication-owningPackage" name="owningPackage" lowerBound="1"
        eType="#T-ocl-Package" resolveProxies="false" eOpposite="#F-ocl-Package-ownedProfileApplications">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The package that owns the profile application."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Property" name="Property" eSuperTypes="#T-ocl-Feature">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Property is a StructuralFeature. A Property related by ownedAttribute to a Classifier (other than an association) represents an attribute and might also represent an association end. It relates an instance of the Classifier to a value or set of values of the type of the attribute. A Property related by memberEnd to an Association represents an end of the Association. The type of the Property is the type of the end of the Association. A Property has the capability of being a DeploymentTarget in a Deployment relationship. This enables modeling the deployment to hierarchical nodes that have Properties functioning as internal parts.  Property specializes ParameterableElement to specify that a Property can be exposed as a formal template parameter, and provided as an actual parameter in a binding of a template."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CompatibleDefaultExpression"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="CompatibleDefaultExpression" value="ownedExpression &lt;> null and ownedExpression.oclAsType(ExpressionInOCL).ownedBody &lt;> null implies CompatibleBody(ownedExpression)"/>
    </eAnnotations>
    <eOperations name="isAttribute" lowerBound="1" eType="#T-ocl-Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="&#xA;--Type.allInstances()->exists(c| c.ownedAttribute->includes(p))&#xA;let container : ocl::OclElement = oclContainer() in container.oclIsKindOf(Class) and container.oclAsType(Class).ownedProperties->includes(self)&#xA;&#xA;"/>
      </eAnnotations>
      <eParameters name="p" lowerBound="1" eType="#T-ocl-Property"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Property-associationClass" name="associationClass" eType="#T-ocl-AssociationClass"
        resolveProxies="false" eOpposite="#F-ocl-AssociationClass-unownedAttributes"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-defaultValue" name="defaultValue" eType="#T-ocl-Object"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-defaultValueString" name="defaultValueString" eType="#T-ocl-String"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isComposite" name="isComposite" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isDerived" name="isDerived" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specifies whether the Property is derived, i.e., whether its value or values can be computed from other information."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isID" name="isID" lowerBound="1" eType="#T-ocl-Boolean" defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="True indicates this property can be used to uniquely identify an instance of the containing Class."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isImplicit" name="isImplicit" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isReadOnly" name="isReadOnly" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="If isReadOnly is true, the StructuralFeature may not be written to after initialization."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isResolveProxies" name="isResolveProxies" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isTransient" name="isTransient" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isUnsettable" name="isUnsettable" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Property-isVolatile" name="isVolatile" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Property-keys" name="keys" ordered="false" upperBound="-1" eType="#T-ocl-Property"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Property-opposite" name="opposite" eType="#T-ocl-Property" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="In the case where the Property is one end of a binary association this gives the other end."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Property-ownedExpression" name="ownedExpression" eType="#T-ocl-LanguageExpression"
        containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Property-owningClass" name="owningClass" eType="#T-ocl-Class" resolveProxies="false"
        eOpposite="#F-ocl-Class-ownedProperties">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Class that owns this Property, if any."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Property-redefinedProperties" name="redefinedProperties" ordered="false"
        upperBound="-1" eType="#T-ocl-Property" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The properties that are redefined by this property, if any."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Property-referredProperty" name="referredProperty" eType="#T-ocl-Property"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Property-subsettedProperty" name="subsettedProperty" ordered="false"
        upperBound="-1" eType="#T-ocl-Property" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The properties of which this Property is constrained to be a subset, if any."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-PropertyCallExp" name="PropertyCallExp" eSuperTypes="#T-ocl-NavigationCallExp #T-ocl-ReferringElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CompatibleResultType NonStaticSourceTypeIsConformant SafeSourceCanBeNull UnsafeSourceCanNotBeNull"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Safe navigation is necessary when the source could be null."/>
      </eAnnotations>
      <details key="CompatibleResultType" value="type = getSpecializedReferredPropertyType()"/>
      <details key="NonStaticSourceTypeIsConformant" value="not referredProperty?.isStatic implies &#xA;&#x9;ownedSource?.type?.conformsTo(getSpecializedReferredPropertyOwningType())&#xA;"/>
      <details key="SafeSourceCanBeNull" value="(ownedSource &lt;> null) and isSafe implies not ownedSource.isNonNull()"/>
      <details key="UnsafeSourceCanNotBeNull" value="(ownedSource &lt;> null) and not isSafe implies ownedSource.isNonNull()"/>
    </eAnnotations>
    <eOperations name="getSpecializedReferredPropertyOwningType" lowerBound="1" eType="#T-ocl-Type">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="referredProperty?.owningClass"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="getSpecializedReferredPropertyType" lowerBound="1" eType="#T-ocl-Type">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="referredProperty?.type.oclAsType(Class)"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-PropertyCallExp-referredProperty" name="referredProperty" eType="#T-ocl-Property"
        resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Pseudostate" name="Pseudostate" eSuperTypes="#T-ocl-Vertex">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Pseudostate is an abstraction that encompasses different types of transient Vertices in the StateMachine graph. A StateMachine instance never comes to rest in a Pseudostate, instead, it will exit and enter the Pseudostate within a single run-to-completion step."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Pseudostate-kind" name="kind" lowerBound="1" eType="#T-ocl-PseudostateKind"
        defaultValueLiteral="initial">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Determines the precise type of the Pseudostate and can be one of: entryPoint, exitPoint, initial, deepHistory, shallowHistory, join, fork, junction, terminate or choice."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Pseudostate-owningState" name="owningState" eType="#T-ocl-State" resolveProxies="false"
        eOpposite="#F-ocl-State-ownedConnectionPoints">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The State that owns this Pseudostate and in which it appears."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Pseudostate-owningStateMachine" name="owningStateMachine" eType="#T-ocl-StateMachine"
        resolveProxies="false" eOpposite="#F-ocl-StateMachine-ownedConnectionPoints">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The StateMachine in which this Pseudostate is defined. This only applies to Pseudostates of the kind entryPoint or exitPoint."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" xmi:id="T-ocl-PseudostateKind" name="PseudostateKind">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="PseudostateKind is an Enumeration type that is used to differentiate various kinds of Pseudostates."/>
    </eAnnotations>
    <eLiterals xmi:id="L-ocl-PseudostateKind-choice" name="choice" value="6"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-deepHistory" name="deepHistory" value="1"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-entryPoint" name="entryPoint" value="7"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-exitPoint" name="exitPoint" value="8"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-fork" name="fork" value="4"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-initial" name="initial"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-join" name="join" value="3"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-junction" name="junction" value="5"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-shallowHistory" name="shallowHistory" value="2"/>
    <eLiterals xmi:id="L-ocl-PseudostateKind-terminate" name="terminate" value="9"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" xmi:id="T-ocl-Real" name="Real" instanceClassName="org.eclipse.ocl.pivot.values.RealValue">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="Primitive"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;The standard type Real represents the mathematical concept of real.&#xA;Note that Integer is a subclass of Real,&#xA;so for each parameter of type Real, you can use an integer as the actual parameter.&#xA;Real is itself an instance of the metatype PrimitiveType (from UML).&#xA;"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-RealLiteralExp" name="RealLiteralExp" eSuperTypes="#T-ocl-NumericLiteralExp">
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-RealLiteralExp-realSymbol" name="realSymbol" lowerBound="1" eType="#T-ocl-Real"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-ReferringElement" name="ReferringElement" eSuperTypes="#T-ocl-OclElement">
    <eOperations name="getReferredElement" lowerBound="1" eType="#T-ocl-Element"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Region" name="Region" eSuperTypes="#T-ocl-Namespace">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Region is a top-level part of a StateMachine or a composite State, that serves as a container for the Vertices and Transitions of the StateMachine. A StateMachine or composite State may contain multiple Regions representing behaviors that may occur in parallel."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Region-extendedRegion" name="extendedRegion" eType="#T-ocl-Region"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The region of which this region is an extension."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Region-ownedSubvertexes" name="ownedSubvertexes" ordered="false" upperBound="-1"
        eType="#T-ocl-Vertex" containment="true" resolveProxies="false" eOpposite="#F-ocl-Vertex-owningRegion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The set of Vertices that are owned by this Region."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Region-ownedTransitions" name="ownedTransitions" ordered="false" upperBound="-1"
        eType="#T-ocl-Transition" containment="true" resolveProxies="false" eOpposite="#F-ocl-Transition-owningRegion">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The set of Transitions owned by the Region."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Region-owningState" name="owningState" eType="#T-ocl-State" resolveProxies="false"
        eOpposite="#F-ocl-State-ownedRegions">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The State that owns the Region. If a Region is owned by a State, then it cannot also be owned by a StateMachine."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Region-owningStateMachine" name="owningStateMachine" eType="#T-ocl-StateMachine"
        resolveProxies="false" eOpposite="#F-ocl-StateMachine-ownedRegions">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The StateMachine that owns the Region. If a Region is owned by a StateMachine, then it cannot also be owned by a State."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-ResultVariable" name="ResultVariable" eSuperTypes="#T-ocl-Variable">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CompatibleNullityForInitializer CompatibleTypeForInitializer HasInitializer"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Result variable has an initializer."/>
      </eAnnotations>
      <details key="CompatibleNullityForInitializer" value="not ownedInit?.isRequired implies not isRequired"/>
      <details key="CompatibleTypeForInitializer" value="ownedInit &lt;> null implies ownedInit.type?.conformsTo(type)"/>
      <details key="HasInitializer" value="ownedInit &lt;> null"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-SelfType" name="SelfType" eSuperTypes="#T-ocl-Class">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;context AssociationClassCallExp&#xA;def: allOCLExpressions() : Set(OCLExpression) = Set{self, source}&#xA;def: referredElements() : Set(Element) = Set{referredAssociationClass}&#xA;&#xA;context IfExp&#xA;def: allOCLExpressions() : Set(OCLExpression) = Set{self, condition, thenExpression, elseExpression}&#xA;&#xA;context IterateExp&#xA;def: allOCLExpressions() : Set(OCLExpression) = Set{self, _'body', result.initExpression}->union(iterator.initExpression)->excluding(null)&#xA;&#xA;context IteratorExp&#xA;def: allOCLExpressions() : Set(OCLExpression) = Set{self, _'body'}->union(iterator.initExpression)->excluding(null)&#xA;&#xA;context LetExp&#xA;def: allOCLExpressions() : Set(OCLExpression) = Set{self, variable.initExpression, _'in'}&#xA;&#xA;context LoopExp&#xA;def: referredElements() : Set(Element) = Set{referredIteration}&#xA;&#xA;context OCLExpression&#xA;def: allOCLExpressions() : Set(OCLExpression) = Set{self}&#xA;--def: allTemplateBindings() : Set(TemplateBinding) = allOCLExpressions().referredElements().templateBindings&#xA;def: referredElements() : Set(Element) = Set{}&#xA;&#xA;context OperationCallExp&#xA;def: allOCLExpressions() : Set(OCLExpression) = Set{self, source}->union(argument)&#xA;def: referredElements() : Set(Element) = Set{referredOperation}&#xA;&#xA;context PropertyCallExp&#xA;def: allOCLExpressions() : Set(OCLExpression) = Set{self, source}&#xA;def: referredElements() : Set(Element) = Set{referredProperty}&#xA;&#xA;context TypeExp&#xA;def: referredElements() : Set(Element) = Set{referredType}&#xA;&#xA;context VariableExp&#xA;def: referredElements() : Set(Element) = Set{referredVariable}&#xA;"/>
    </eAnnotations>
    <eOperations name="specializeIn" lowerBound="1" eType="#T-ocl-Type">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="selfType"/>
      </eAnnotations>
      <eParameters name="expr" lowerBound="1" eType="#T-ocl-CallExp"/>
      <eParameters name="selfType" lowerBound="1" eType="#T-ocl-Type"/>
    </eOperations>
  </eClassifiers>
