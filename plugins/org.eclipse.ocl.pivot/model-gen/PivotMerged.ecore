      <eParameters name="b" eType="#T-ocl-Boolean"/>
    </eOperations>
    <eOperations name="not" eType="#T-ocl-Boolean"/>
    <eOperations name="oclAsType">
      <eGenericType eTypeParameter="#//OclVoid/oclAsType/TT"/>
      <eTypeParameters name="TT"/>
      <eParameters name="type" lowerBound="1">
        <eGenericType eTypeParameter="#//OclVoid/oclAsType/TT"/>
      </eParameters>
    </eOperations>
    <eOperations name="oclIsInvalid" lowerBound="1" eType="#T-ocl-Boolean"/>
    <eOperations name="oclIsKindOf" lowerBound="1" eType="#T-ocl-Boolean">
