  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-LoopExp" name="LoopExp" eSuperTypes="#T-ocl-CallExp">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="LiteralExp&#xA;No additional well-formedness rules."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="MatchingMapCoIterators MatchingOrderedCollectionCoIterators NoCoInitializers NoInitializers NoNotOrderedCollectionCoIterators SourceIsCollection SourceIsIterable"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The type of the source expression must be a collection or map."/>
      </eAnnotations>
      <details key="MatchingMapCoIterators" value="ownedSource?.type.oclIsKindOf(MapType) implies (self.ownedCoIterators->size() = 0) or (self.ownedCoIterators->size() = self.ownedIterators->size())"/>
      <details key="MatchingOrderedCollectionCoIterators" value="(ownedSource?.type.oclIsKindOf(OrderedSetType) or ownedSource?.type.oclIsKindOf(SequenceType)) implies (self.ownedCoIterators->size() = 0) or (self.ownedCoIterators->size() = self.ownedIterators->size())"/>
      <details key="NoCoInitializers" value="self.ownedCoIterators?->forAll(ownedInit->isEmpty())"/>
      <details key="NoInitializers" value="self.ownedIterators->forAll(ownedInit->isEmpty())"/>
      <details key="NoNotOrderedCollectionCoIterators" value="(ownedSource?.type.oclIsKindOf(BagType) or ownedSource?.type.oclIsKindOf(SetType)) implies self.ownedCoIterators->isEmpty()"/>
      <details key="SourceIsCollection" value="true"/>
      <details key="SourceIsIterable" value="ownedSource?.type.oclIsKindOf(IterableType)"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-LoopExp-firstOwnedBody" name="firstOwnedBody" lowerBound="1" eType="#T-ocl-OCLExpression"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-LoopExp-ownedCoIterators" name="ownedCoIterators" upperBound="-1" eType="#T-ocl-IteratorVariable"
        containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-LoopExp-ownedIterators" name="ownedIterators" upperBound="-1" eType="#T-ocl-Variable"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-LoopExp-referredIteration" name="referredIteration" eType="#T-ocl-Iteration"
        resolveProxies="false"/>
  </eClassifiers>
