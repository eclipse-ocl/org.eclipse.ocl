      <details key="documentation" value="&#xA;The pseudo-type OclSelf denotes the statically determinate type of oclText[self] in Operation&#xA;and Iteration signatures. Instances of OclSelf are never created.&#xA;"/>
    </eAnnotations>
  </eClassifiers>
