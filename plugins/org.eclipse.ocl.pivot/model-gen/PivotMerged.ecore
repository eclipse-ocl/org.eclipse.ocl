  <eClassifiers xsi:type="ecore:EDataType" xmi:id="T-ocl-Throwable" name="Throwable" instanceClassName="java.lang.Throwable"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Transition" name="Transition" eSuperTypes="#T-ocl-Namespace">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Transition represents an arc between exactly one source Vertex and exactly one Target vertex (the source and targets may be the same Vertex). It may form part of a compound transition, which takes the StateMachine from one steady State configuration to another, representing the full response of the StateMachine to an occurrence of an Event that triggered it."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Transition-kind" name="kind" lowerBound="1" eType="#T-ocl-TransitionKind"
        defaultValueLiteral="external">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Indicates the precise type of the Transition."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Transition-ownedEffect" name="ownedEffect" eType="#T-ocl-Behavior"
        containment="true" resolveProxies="false" eOpposite="#F-ocl-Behavior-owningTransition">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specifies an optional behavior to be performed when the Transition fires."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Transition-ownedGuard" name="ownedGuard" eType="#T-ocl-Constraint"
        containment="true" resolveProxies="false" eOpposite="#F-ocl-Constraint-owningTransition">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A guard is a Constraint that provides a fine-grained control over the firing of the Transition. The guard is evaluated when an Event occurrence is dispatched by the StateMachine. If the guard is true at that time, the Transition may be enabled, otherwise, it is disabled. Guards should be pure expressions without side effects. Guard expressions with side effects are ill formed."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Transition-ownedTriggers" name="ownedTriggers" ordered="false" upperBound="-1"
        eType="#T-ocl-Trigger" containment="true" resolveProxies="false" eOpposite="#F-ocl-Trigger-owningTransition">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specifies the Triggers that may fire the transition."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Transition-owningRegion" name="owningRegion" lowerBound="1" eType="#T-ocl-Region"
        resolveProxies="false" eOpposite="#F-ocl-Region-ownedTransitions">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Designates the Region that owns this Transition."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Transition-source" name="source" lowerBound="1" eType="#T-ocl-Vertex"
        resolveProxies="false" eOpposite="#F-ocl-Vertex-outgoingTransitions">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Designates the originating Vertex (State or Pseudostate) of the Transition."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Transition-target" name="target" lowerBound="1" eType="#T-ocl-Vertex"
        resolveProxies="false" eOpposite="#F-ocl-Vertex-incomingTransitions">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Designates the target Vertex that is reached when the Transition is taken."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EEnum" xmi:id="T-ocl-TransitionKind" name="TransitionKind">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="TransitionKind is an Enumeration type used to differentiate the various kinds of Transitions."/>
    </eAnnotations>
    <eLiterals xmi:id="L-ocl-TransitionKind-external" name="external" value="2">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Implies that the Transition, if triggered, will exit the composite (source) State."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals xmi:id="L-ocl-TransitionKind-internal" name="internal">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Implies that the Transition, if triggered, occurs without exiting or entering the source State (i.e., it does not cause a state change). This means that the entry or exit condition of the source State will not be invoked. An internal Transition can be taken even if the SateMachine is in one or more Regions nested within the associated State."/>
      </eAnnotations>
    </eLiterals>
    <eLiterals xmi:id="L-ocl-TransitionKind-local" name="local" value="1">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Implies that the Transition, if triggered, will not exit the composite (source) State, but it will exit and re-enter any state within the composite State that is in the current state configuration."/>
      </eAnnotations>
    </eLiterals>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Trigger" name="Trigger" eSuperTypes="#T-ocl-NamedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Trigger specifies a specific point  at which an Event occurrence may trigger an effect in a Behavior. A Trigger may be qualified by the Port on which the Event occurred."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Trigger-owningState" name="owningState" eType="#T-ocl-State" resolveProxies="false"
        eOpposite="#F-ocl-State-ownedDeferrableTriggers"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Trigger-owningTransition" name="owningTransition" eType="#T-ocl-Transition"
        resolveProxies="false" eOpposite="#F-ocl-Transition-ownedTriggers"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-TupleLiteralExp" name="TupleLiteralExp" eSuperTypes="#T-ocl-LiteralExp">
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TupleLiteralExp-ownedParts" name="ownedParts" upperBound="-1" eType="#T-ocl-TupleLiteralPart"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-TupleLiteralPart" name="TupleLiteralPart" eSuperTypes="#T-ocl-VariableDeclaration">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CompatibleInitialiserType TypeIsNotInvalid"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="CompatibleInitialiserType" value="ownedInit &lt;> null and ownedInit.type &lt;> null implies ownedInit.type.conformsTo(type)"/>
      <details key="TypeIsNotInvalid" value="type &lt;> OclInvalid"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TupleLiteralPart-ownedInit" name="ownedInit" eType="#T-ocl-OCLExpression"
        containment="true" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-TupleType" name="TupleType" eSuperTypes="#T-ocl-DataType"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Type" name="Type" eSuperTypes="#T-ocl-OclType #T-ocl-NamedElement">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="UML"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;The UML Type is the supertype of anything that may be used as a type.&#xA;"/>
    </eAnnotations>
    <eOperations name="conformsTo" lowerBound="1" eType="#T-ocl-Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;Returns true if type2 conforms to self.&#xA;"/>
      </eAnnotations>
      <eParameters name="type2" eType="#T-ocl-Type"/>
    </eOperations>
    <eOperations name="flattenedType" eType="#T-ocl-Type">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;Return the type to be used as the element type when this is flattened. For most types this is self.&#xA;For a CollectionType, it is the transitive element type.&#xA;"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="self"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="isClass" eType="#T-ocl-Class"/>
    <eOperations name="isTemplateParameter" eType="#T-ocl-TemplateParameter"/>
    <eOperations name="specializeIn" lowerBound="1" eType="#T-ocl-Type">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="self"/>
      </eAnnotations>
      <eParameters name="expr" lowerBound="1" eType="#T-ocl-CallExp"/>
      <eParameters name="selfType" lowerBound="1" eType="#T-ocl-Type"/>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-TypeExp" name="TypeExp" eSuperTypes="#T-ocl-OCLExpression #T-ocl-ReferringElement">
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TypeExp-referredType" name="referredType" eType="#T-ocl-Type" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-TypedElement" name="TypedElement" eSuperTypes="#T-ocl-NamedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A TypedElement is a NamedElement that may have a Type specified for it."/>
    </eAnnotations>
    <eOperations name="CompatibleBody" lowerBound="1" eType="#T-ocl-Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="bodySpecification.type?.conformsTo(self.type)"/>
      </eAnnotations>
      <eParameters name="bodySpecification" lowerBound="1" eType="#T-ocl-ValueSpecification"/>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-TypedElement-isMany" name="isMany" lowerBound="1" eType="#T-ocl-Boolean"
        changeable="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-TypedElement-isRequired" name="isRequired" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TypedElement-type" name="type" eType="#T-ocl-Type" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The type of the TypedElement."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-UniqueCollection" name="UniqueCollection" instanceClassName="java.util.Collection"
      abstract="true" interface="true">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="Collection"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;The UniqueCollection type provides the shared functionality of the OrderedSet and Set&#xA;collections for which the elements are unique.&#xA;The common supertype of UniqueCollection is Collection.&#xA;"/>
    </eAnnotations>
    <eTypeParameters name="T"/>
    <eGenericSuperTypes eClassifier="#T-ocl-Collection">
      <eTypeArguments eTypeParameter="#//UniqueCollection/T"/>
    </eGenericSuperTypes>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" xmi:id="T-ocl-UnlimitedNatural" name="UnlimitedNatural" instanceClassName="org.eclipse.ocl.pivot.values.UnlimitedNaturalValue">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="Primitive"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;The standard type UnlimitedNatural is used to encode the non-negative values of a multiplicity specification.&#xA;This includes a special e[unlimited] value (*) that encodes the upper value of a multiplicity specification.&#xA;UnlimitedNatural is itself an instance of the metatype UnlimitedNaturalType.&#xA;&#xA;Note that UnlimitedNatural is not a subclass of Integer.&#xA;"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-UnlimitedNaturalLiteralExp" name="UnlimitedNaturalLiteralExp" eSuperTypes="#T-ocl-NumericLiteralExp">
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-UnlimitedNaturalLiteralExp-unlimitedNaturalSymbol" name="unlimitedNaturalSymbol"
        lowerBound="1" eType="#T-ocl-UnlimitedNatural"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-UnspecifiedValueExp" name="UnspecifiedValueExp" eSuperTypes="#T-ocl-OCLExpression"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-ValueSpecification" name="ValueSpecification" eSuperTypes="#T-ocl-TypedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A ValueSpecification is the specification of a (possibly empty) set of values. A ValueSpecification is a ParameterableElement that may be exposed as a formal TemplateParameter and provided as the actual parameter in the binding of a template."/>
    </eAnnotations>
    <eOperations name="booleanValue" lowerBound="1" eType="#T-ocl-Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The query booleanValue() gives a single Boolean value when one can be computed."/>
      </eAnnotations>
    </eOperations>
    <eOperations name="integerValue" eType="#T-ocl-Integer">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The query integerValue() gives a single Integer value when one can be computed."/>
      </eAnnotations>
    </eOperations>
    <eOperations name="isComputable" lowerBound="1" eType="#T-ocl-Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The query isComputable() determines whether a value specification can be computed in a model. This operation cannot be fully defined in OCL. A conforming implementation is expected to deliver true for this operation for all ValueSpecifications that it can compute, and to compute all of those for which the operation is true. A conforming implementation is expected to be able to compute at least the value of all LiteralSpecifications."/>
      </eAnnotations>
    </eOperations>
    <eOperations name="isNull" lowerBound="1" eType="#T-ocl-Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The query isNull() returns true when it can be computed that the value is null."/>
      </eAnnotations>
    </eOperations>
    <eOperations name="stringValue" eType="#T-ocl-String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The query stringValue() gives a single String value when one can be computed."/>
      </eAnnotations>
    </eOperations>
    <eOperations name="unlimitedValue" eType="#T-ocl-UnlimitedNatural">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The query unlimitedValue() gives a single UnlimitedNatural value when one can be computed."/>
      </eAnnotations>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Variable" name="Variable" eSuperTypes="#T-ocl-VariableDeclaration">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CompatibleInitialiserType"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="CompatibleInitialiserType" value="true"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Variable-isImplicit" name="isImplicit" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Variable-ownedInit" name="ownedInit" eType="#T-ocl-OCLExpression" containment="true"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Variable-representedParameter" name="representedParameter" eType="#T-ocl-Parameter"
        resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-VariableDeclaration" name="VariableDeclaration" eSuperTypes="#T-ocl-TypedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="NameIsNotNull TypeIsNotInvalid TypeIsNotNull"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="NameIsNotNull" value="name &lt;> null"/>
      <details key="TypeIsNotInvalid" value="type &lt;> OclInvalid"/>
      <details key="TypeIsNotNull" value="type &lt;> null"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-VariableDeclaration-typeValue" name="typeValue" eType="#T-ocl-Type"
        resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-VariableExp" name="VariableExp" eSuperTypes="#T-ocl-OCLExpression #T-ocl-ReferringElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TypeIsNotInvalid"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="TypeIsNotInvalid" value="type &lt;> OclInvalid"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-VariableExp-isImplicit" name="isImplicit" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-VariableExp-referredVariable" name="referredVariable" eType="#T-ocl-VariableDeclaration"
        resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Vertex" name="Vertex" eSuperTypes="#T-ocl-NamedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Vertex is an abstraction of a node in a StateMachine graph. It can be the source or destination of any number of Transitions."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Vertex-incomingTransitions" name="incomingTransitions" ordered="false"
        upperBound="-1" eType="#T-ocl-Transition" changeable="false" resolveProxies="false" eOpposite="#F-ocl-Transition-target">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specifies the Transitions entering this Vertex."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Vertex-outgoingTransitions" name="outgoingTransitions" ordered="false"
        upperBound="-1" eType="#T-ocl-Transition" changeable="false" resolveProxies="false" eOpposite="#F-ocl-Transition-source">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specifies the Transitions departing from this Vertex."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Vertex-owningRegion" name="owningRegion" eType="#T-ocl-Region" resolveProxies="false"
        eOpposite="#F-ocl-Region-ownedSubvertexes">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Region that contains this Vertex."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Visitable" name="Visitable" instanceClassName="org.eclipse.ocl.pivot.util.Visitable"
      eSuperTypes="#T-ocl-OclElement"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-VoidType" name="VoidType" eSuperTypes="#T-ocl-OclElement #T-ocl-Class">
    <eOperations name="allInstances" ordered="false" lowerBound="1" eType="#T-ocl-OclSelf">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
