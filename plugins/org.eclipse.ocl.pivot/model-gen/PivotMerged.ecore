  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-ShadowExp" name="ShadowExp" eSuperTypes="#T-ocl-OCLExpression">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ClassHasNoStringValueInitializer DataTypeHasNoPartInitializers DataTypeHasOnePartInitializer DataTypeHasStringValueInitializer InitializesAllClassProperties TypeIsNotInvalid"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="ClassHasNoStringValueInitializer" value="true"/>
      <details key="DataTypeHasNoPartInitializers" value="true"/>
      <details key="DataTypeHasOnePartInitializer" value="type.oclIsKindOf(DataType) implies ownedParts->size() = 1"/>
      <details key="DataTypeHasStringValueInitializer" value="true"/>
      <details key="InitializesAllClassProperties" value="if type.oclIsKindOf(DataType) then Tuple{status:Boolean[?]=true, message:String[1]=''}.status else &#xA;&#x9;let partProperties = ownedParts.referredProperty->asSet() in&#xA;&#x9;let allProperties = type.oclAsType(Class)->closure(superClasses).ownedProperties->asSet() in&#xA;&#x9;let classProperties = allProperties->reject(isDerived or isImplicit or isStatic or isTransient)->reject(name?.startsWith('ocl')) in&#xA;&#x9;let requiredClassProperties = classProperties->reject(defaultValueString &lt;> null)->reject(isVolatile or not isRequired)->reject(type.oclIsKindOf(CollectionType))->reject((opposite&lt;>null) and opposite.isComposite) in&#xA;&#x9;let extraProperties : Set(NamedElement[*|1]) = partProperties->excludingAll(classProperties) in&#xA;&#x9;let missingProperties : Set(NamedElement[*|1]) = requiredClassProperties->excludingAll(partProperties) in&#xA;&#x9;if extraProperties->notEmpty() then Tuple{status:Boolean[?]=false, message:String[1]=extraProperties->sortedBy(name)->iterate(p; acc:String='Unexpected initializers:'|acc +' ' + p.name)}.status&#xA;&#x9;else if missingProperties->notEmpty() then Tuple{status:Boolean[?]=false, message:String[1]=missingProperties->sortedBy(name)->iterate(p; acc:String='Missing initializers:'|acc +' ' + p.name)}.status&#xA;&#x9;else Tuple{status:Boolean[?]=true, message:String[1]=''}.status&#xA;&#x9;endif endif endif&#xA;"/>
      <details key="TypeIsNotInvalid" value="type &lt;> OclInvalid"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-ShadowExp-ownedParts" name="ownedParts" upperBound="-1" eType="#T-ocl-ShadowPart"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-ShadowExp-value" name="value" eType="#T-ocl-String"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-ShadowPart" name="ShadowPart" eSuperTypes="#T-ocl-TypedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CompatibleInitialiserType TypeIsNotInvalid TypeIsNotNull"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="CompatibleInitialiserType" value="ownedInit.type?.conformsTo(type)"/>
      <details key="TypeIsNotInvalid" value="type &lt;> OclInvalid"/>
      <details key="TypeIsNotNull" value="type &lt;> null"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-ShadowPart-ownedInit" name="ownedInit" lowerBound="1" eType="#T-ocl-OCLExpression"
        containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-ShadowPart-referredProperty" name="referredProperty" lowerBound="1"
        eType="#T-ocl-Property" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Signal" name="Signal" eSuperTypes="#T-ocl-Class">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Signal is a specification of a kind of communication between objects in which a reaction is asynchronously triggered in the receiver without a reply."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Slot" name="Slot" eSuperTypes="#T-ocl-Element">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Slot designates that an entity modeled by an InstanceSpecification has a value or values for a specific StructuralFeature."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Slot-definingProperty" name="definingProperty" lowerBound="1" eType="#T-ocl-Property"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The StructuralFeature that specifies the values that may be held by the Slot."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Slot-ownedValues" name="ownedValues" upperBound="-1" eType="#T-ocl-ValueSpecification"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value or values held by the Slot."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Slot-owningInstance" name="owningInstance" lowerBound="1" eType="#T-ocl-InstanceSpecification"
        resolveProxies="false" eOpposite="#F-ocl-InstanceSpecification-ownedSlots">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The InstanceSpecification that owns this Slot."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-StandardLibrary" name="StandardLibrary" eSuperTypes="#T-ocl-Element"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-State" name="State" eSuperTypes="#T-ocl-OclState #T-ocl-Namespace #T-ocl-Vertex">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="UML"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A State models a situation during which some (usually implicit) invariant condition holds."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-State-isComposite" name="isComposite" lowerBound="1" eType="#T-ocl-Boolean"
        changeable="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A state with isComposite=true is said to be a composite State. A composite State is a State that contains at least one Region."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-State-isOrthogonal" name="isOrthogonal" lowerBound="1" eType="#T-ocl-Boolean"
        changeable="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A State with isOrthogonal=true is said to be an orthogonal composite State An orthogonal composite State contains two or more Regions."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-State-isSimple" name="isSimple" lowerBound="1" eType="#T-ocl-Boolean"
        changeable="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A State with isSimple=true is said to be a simple State A simple State does not have any Regions and it does not refer to any submachine StateMachine."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-State-isSubmachineState" name="isSubmachineState" lowerBound="1" eType="#T-ocl-Boolean"
        changeable="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A State with isSubmachineState=true is said to be a submachine State Such a State refers to another StateMachine(submachine)."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-ownedConnectionPoints" name="ownedConnectionPoints" ordered="false"
        upperBound="-1" eType="#T-ocl-Pseudostate" containment="true" resolveProxies="false" eOpposite="#F-ocl-Pseudostate-owningState">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The entry and exit Pseudostates of a composite State. These can only be entry or exit Pseudostates, and they must have different names. They can only be defined for composite States."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-ownedConnections" name="ownedConnections" ordered="false" upperBound="-1"
        eType="#T-ocl-ConnectionPointReference" containment="true" resolveProxies="false" eOpposite="#F-ocl-ConnectionPointReference-owningState">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The entry and exit connection points used in conjunction with this (submachine) State, i.e., as targets and sources, respectively, in the Region with the submachine State. A connection point reference references the corresponding definition of a connection point Pseudostate in the StateMachine referenced by the submachine State."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-ownedDeferrableTriggers" name="ownedDeferrableTriggers" ordered="false"
        upperBound="-1" eType="#T-ocl-Trigger" containment="true" resolveProxies="false" eOpposite="#F-ocl-Trigger-owningState">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A list of Triggers that are candidates to be retained by the StateMachine if they trigger no Transitions out of the State (not consumed). A deferred Trigger is retained until the StateMachine reaches a State configuration where it is no longer deferred."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-ownedDoActivity" name="ownedDoActivity" eType="#T-ocl-Behavior"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An optional Behavior that is executed while being in the State. The execution starts when this State is entered, and ceases either by itself when done, or when the State is exited, whichever comes first."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-ownedEntry" name="ownedEntry" eType="#T-ocl-Behavior" containment="true"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An optional Behavior that is executed whenever this State is entered regardless of the Transition taken to reach the State. If defined, entry Behaviors are always executed to completion prior to any internal Behavior or Transitions performed within the State."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-ownedExit" name="ownedExit" eType="#T-ocl-Behavior" containment="true"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An optional Behavior that is executed whenever this State is exited regardless of which Transition was taken out of the State. If defined, exit Behaviors are always executed to completion only after all internal and transition Behaviors have completed execution."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-ownedRegions" name="ownedRegions" ordered="false" upperBound="-1"
        eType="#T-ocl-Region" containment="true" resolveProxies="false" eOpposite="#F-ocl-Region-owningState">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Regions owned directly by the State."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-ownedStateInvariant" name="ownedStateInvariant" eType="#T-ocl-Constraint"
        containment="true" resolveProxies="false" eOpposite="#F-ocl-Constraint-owningState">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specifies conditions that are always true when this State is the current State. In ProtocolStateMachines state invariants are additional conditions to the preconditions of the outgoing Transitions, and to the postcondition of the incoming Transitions."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-redefinedState" name="redefinedState" eType="#T-ocl-State" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The State of which this State is a redefinition."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-State-submachines" name="submachines" eType="#T-ocl-StateMachine" resolveProxies="false"
        eOpposite="#F-ocl-StateMachine-submachineStates">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The StateMachine that is to be inserted in place of the (submachine) State."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-StateExp" name="StateExp" eSuperTypes="#T-ocl-OCLExpression">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TypeIsNotInvalid"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="TypeIsNotInvalid" value="type &lt;> OclInvalid"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-StateExp-referredState" name="referredState" eType="#T-ocl-State" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-StateMachine" name="StateMachine" eSuperTypes="#T-ocl-Behavior">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="StateMachines can be used to express event-driven behaviors of parts of a system. Behavior is modeled as a traversal of a graph of Vertices interconnected by one or more joined Transition arcs that are triggered by the dispatching of successive Event occurrences. During this traversal, the StateMachine may execute a sequence of Behaviors associated with various elements of the StateMachine."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-StateMachine-extendedStateMachines" name="extendedStateMachines" ordered="false"
        upperBound="-1" eType="#T-ocl-StateMachine" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The StateMachines of which this is an extension."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-StateMachine-ownedConnectionPoints" name="ownedConnectionPoints" ordered="false"
        upperBound="-1" eType="#T-ocl-Pseudostate" containment="true" resolveProxies="false" eOpposite="#F-ocl-Pseudostate-owningStateMachine">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The connection points defined for this StateMachine. They represent the interface of the StateMachine when used as part of submachine State"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-StateMachine-ownedRegions" name="ownedRegions" ordered="false" lowerBound="1"
        upperBound="-1" eType="#T-ocl-Region" containment="true" resolveProxies="false" eOpposite="#F-ocl-Region-owningStateMachine">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Regions owned directly by the StateMachine."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-StateMachine-submachineStates" name="submachineStates" ordered="false"
        upperBound="-1" eType="#T-ocl-State" resolveProxies="false" eOpposite="#F-ocl-State-submachines">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="References the submachine(s) in case of a submachine State. Multiple machines are referenced in case of a concurrent State."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Stereotype" name="Stereotype" eSuperTypes="#T-ocl-OclStereotype #T-ocl-Class">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A stereotype defines how an existing metaclass may be extended, and enables the use of platform or domain specific terminology or notation in place of, or in addition to, the ones used for the extended metaclass."/>
    </eAnnotations>
    <eOperations name="allInstances" ordered="false" upperBound="-1" eType="#T-ocl-OclSelf">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;Return a set of all instances of the stereotype and derived types of self.&#xA;"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Stereotype-ownedExtenders" name="ownedExtenders" ordered="false" upperBound="-1"
        eType="#T-ocl-StereotypeExtender" containment="true" resolveProxies="false" eOpposite="#F-ocl-StereotypeExtender-owningStereotype">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-StereotypeExtender" name="StereotypeExtender" eSuperTypes="#T-ocl-Element">
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-StereotypeExtender-class" name="class" lowerBound="1" eType="#T-ocl-Class"
        resolveProxies="false" eOpposite="#F-ocl-Class-extenders"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-StereotypeExtender-isRequired" name="isRequired" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-StereotypeExtender-owningStereotype" name="owningStereotype" lowerBound="1"
        eType="#T-ocl-Stereotype" resolveProxies="false" eOpposite="#F-ocl-Stereotype-ownedExtenders"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" xmi:id="T-ocl-String" name="String" instanceClassName="java.lang.String">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="Primitive"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;The standard type String represents strings, which can be both ASCII or Unicode.&#xA;String is itself an instance of the metatype PrimitiveType (from UML).&#xA;"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-StringLiteralExp" name="StringLiteralExp" eSuperTypes="#T-ocl-PrimitiveLiteralExp">
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-StringLiteralExp-stringSymbol" name="stringSymbol" lowerBound="1" eType="#T-ocl-String"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-TemplateArgument" name="TemplateArgument" eSuperTypes="#T-ocl-Element">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A TemplateArgument relates the actual optional type to a formal TemplateParameter by positional equivalence of a TemplateableElement's  hierarchy of TemplateParameters and ownedTemplateArguments."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateArgument-actual" name="actual" lowerBound="1" eType="#T-ocl-Type"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The ParameterableElement that is the actual parameter for this TemplateArgument."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-TemplateArgument-actualIsRequired" name="actualIsRequired" lowerBound="1"
        eType="#T-ocl-Boolean" defaultValueLiteral="true">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether the actual type must be non-null rather than nullable."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateArgument-formal" name="formal" lowerBound="1" eType="#T-ocl-TemplateParameter"
        changeable="false" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The formal TemplateParameter that is associated with this TemplateArgument."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateArgument-owningTemplateableElement" name="owningTemplateableElement"
        lowerBound="1" eType="#T-ocl-TemplateableElement" resolveProxies="false" eOpposite="#F-ocl-TemplateableElement-ownedTemplateArguments">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The TemplateBinding that owns this TemplateArgument."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-TemplateParameter" name="TemplateParameter" eSuperTypes="#T-ocl-Type">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A TemplateParameter exposes a ParameterableElement as a formal parameter of a template."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateParameter-constrainingClasses" name="constrainingClasses" ordered="false"
        upperBound="-1" eType="#T-ocl-Class" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateParameter-owningTemplateableElement" name="owningTemplateableElement"
        lowerBound="1" eType="#T-ocl-TemplateableElement" resolveProxies="false" eOpposite="#F-ocl-TemplateableElement-ownedTemplateParameters">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The TemplateSignature that owns this TemplateableElement."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-TemplateableElement" name="TemplateableElement" eSuperTypes="#T-ocl-Element">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A TemplateableElement is an Element that can optionally be defined as a specialization of a generic TemplateableElement."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateableElement-generic" name="generic" eType="#T-ocl-TemplateableElement"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateableElement-ownedTemplateArguments" name="ownedTemplateArguments"
        ordered="false" upperBound="-1" eType="#T-ocl-TemplateArgument" containment="true" resolveProxies="false" eOpposite="#F-ocl-TemplateArgument-owningTemplateableElement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The optional TemplateBindings from this TemplateableElement to one or more templates."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateableElement-ownedTemplateParameters" name="ownedTemplateParameters"
        upperBound="-1" eType="#T-ocl-TemplateParameter" containment="true" resolveProxies="false" eOpposite="#F-ocl-TemplateParameter-owningTemplateableElement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The formal parameters that are owned by this TemplateableElement."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-TemplateableElement-ownedWildcards" name="ownedWildcards" upperBound="-1"
        eType="#T-ocl-WildcardType" containment="true" resolveProxies="false" eOpposite="#F-ocl-WildcardType-owningTemplateableElement">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The implicit 'template parameters' for wildcards within this TemplateableElement."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
