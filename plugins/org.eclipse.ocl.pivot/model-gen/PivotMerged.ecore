    <eOperations name="_61" lowerBound="1" eType="#T-ocl-Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;Redefines the OclAny operation, returning oclText[true] if object is oclText[null], oclText[invalid]&#xA;if object is oclText[invalid], oclText[false] otherwise.&#xA;"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/uml2/2.0.0/UML">
        <details key="originalName" value="="/>
      </eAnnotations>
      <eParameters name="object2" eType="#T-ocl-OclSelf"/>
    </eOperations>
    <eOperations name="and" eType="#T-ocl-Boolean">
      <eParameters name="b" eType="#T-ocl-Boolean"/>
    </eOperations>
    <eOperations name="concat" lowerBound="1" eType="#T-ocl-String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;The concatenation of oclText[null] and s.&#xA;"/>
      </eAnnotations>
      <eParameters name="s" eType="#T-ocl-String"/>
    </eOperations>
