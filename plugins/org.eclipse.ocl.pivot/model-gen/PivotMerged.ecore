  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-WildcardType" name="WildcardType" eSuperTypes="#T-ocl-Class">
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-WildcardType-lowerBound" name="lowerBound" eType="#T-ocl-Type" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-WildcardType-owningTemplateableElement" name="owningTemplateableElement"
        eType="#T-ocl-TemplateableElement" resolveProxies="false" eOpposite="#F-ocl-TemplateableElement-ownedWildcards"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-WildcardType-upperBound" name="upperBound" eType="#T-ocl-Type" resolveProxies="false"/>
  </eClassifiers>
</ecore:EPackage>
