        resolveProxies="false" eOpposite="#F-ocl-Operation-ownedParameters">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Operation owning this parameter."/>
      </eAnnotations>
    </eStructuralFeatures>
