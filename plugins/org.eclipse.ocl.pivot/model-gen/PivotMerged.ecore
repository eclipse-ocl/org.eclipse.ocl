  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Operation" name="Operation" eSuperTypes="#T-ocl-Feature #T-ocl-Namespace #T-ocl-TemplateableElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An Operation is a BehavioralFeature of a Classifier that specifies the name, type, parameters, and constraints for invoking an associated Behavior. An Operation may invoke both the execution of method behaviors as well as other behavioral responses. Operation specializes TemplateableElement in order to support specification of template operations and bound operations. Operation specializes ParameterableElement to specify that an operation can be exposed as a formal template parameter, and provided as an actual parameter in a binding of a template."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="CompatibleReturn LoadableImplementation UniquePostconditionName UniquePreconditionName"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="CompatibleReturn" value="bodyExpression &lt;> null and bodyExpression.oclAsType(ExpressionInOCL).ownedBody &lt;> null implies CompatibleBody(bodyExpression)"/>
      <details key="LoadableImplementation" value="true"/>
      <details key="UniquePostconditionName" value="ownedPostconditions->isUnique(name)"/>
      <details key="UniquePreconditionName" value="ownedPreconditions->isUnique(name)"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Operation-bodyExpression" name="bodyExpression" eType="#T-ocl-LanguageExpression"
        containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Operation-isInvalidating" name="isInvalidating" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether this operation may return an invalid result for non-invalid (or invalid if also validating) inputs."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Operation-isTransient" name="isTransient" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Operation-isTypeof" name="isTypeof" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Operation-isValidating" name="isValidating" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Whether this operation may return a non-invalid result for invalid inputs."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Operation-ownedParameters" name="ownedParameters" upperBound="-1" eType="#T-ocl-Parameter"
        containment="true" resolveProxies="false" eOpposite="#F-ocl-Parameter-owningOperation">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The ordered set of formal Parameters of this BehavioralFeature.&#xA;&#xA;The parameters owned by this Operation."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Operation-ownedPostconditions" name="ownedPostconditions" ordered="false"
        upperBound="-1" eType="#T-ocl-Constraint" containment="true" resolveProxies="false" eOpposite="#F-ocl-Constraint-owningPostContext">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An optional set of Constraints specifying the state of the system when the Operation is completed."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Operation-ownedPreconditions" name="ownedPreconditions" ordered="false"
        upperBound="-1" eType="#T-ocl-Constraint" containment="true" resolveProxies="false" eOpposite="#F-ocl-Constraint-owningPreContext">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An optional set of Constraints on the state of the system when the Operation is invoked."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Operation-owningClass" name="owningClass" eType="#T-ocl-Class" resolveProxies="false"
        eOpposite="#F-ocl-Class-ownedOperations">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Class that owns this operation, if any."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Operation-precedence" name="precedence" eType="#T-ocl-Precedence" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Operation-raisedExceptions" name="raisedExceptions" ordered="false"
        upperBound="-1" eType="#T-ocl-Type" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Types representing exceptions that may be raised during an invocation of this BehavioralFeature.&#xA;&#xA;The Types representing exceptions that may be raised during an invocation of this operation."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Operation-redefinedOperations" name="redefinedOperations" ordered="false"
        upperBound="-1" eType="#T-ocl-Operation" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Operations that are redefined by this Operation."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-OperationCallExp" name="OperationCallExp" eSuperTypes="#T-ocl-FeatureCallExp #T-ocl-ReferringElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="------------- spelling: arguments"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ArgumentCount ArgumentTypeIsConformant SafeSourceCanBeNull UnsafeSourceCanNotBeNull"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Safe navigation is necessary when the source could be null. -- unless infix with an OclVoid overload"/>
      </eAnnotations>
      <details key="ArgumentCount" value="ownedArguments->size() = referredOperation?.ownedParameters?->size()"/>
      <details key="ArgumentTypeIsConformant" value="&#xA;&#x9;let operation : Operation = self.referredOperation in&#xA;&#x9;let parameters : OrderedSet(Parameter) = operation?.ownedParameters in&#xA;&#x9;let selfType : Type = operation?.owningClass in&#xA;&#x9;Sequence{1..ownedArguments->size()}->forAll (i | &#xA;&#x9;&#x9;let argument : OCLExpression = ownedArguments->at(i) in&#xA;&#x9;&#x9;let parameter : Parameter = parameters?->at(i) in&#xA;&#x9;&#x9;let parameterType : Type = parameter.type in&#xA;&#x9;&#x9;let requiredType : Type = if parameter.isTypeof then Class else parameterType?.specializeIn(self, selfType) endif in&#xA;&#x9;&#x9;argument.type?.conformsTo(requiredType))&#xA;&#xA;"/>
      <details key="SafeSourceCanBeNull" value="(ownedSource &lt;> null) and isSafe implies not ownedSource.isNonNull()"/>
      <details key="UnsafeSourceCanNotBeNull" value="(not hasOclVoidOverload()) implies ((ownedSource &lt;> null) and not isSafe implies ownedSource.isNonNull())"/>
    </eAnnotations>
    <eOperations name="hasOclVoidOverload" lowerBound="1" eType="#T-ocl-Boolean">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="false"/>
      </eAnnotations>
    </eOperations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-OperationCallExp-isVirtual" name="isVirtual" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-OperationCallExp-ownedArguments" name="ownedArguments" upperBound="-1"
        eType="#T-ocl-OCLExpression" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-OperationCallExp-referredOperation" name="referredOperation" eType="#T-ocl-Operation"
        resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-OppositePropertyCallExp" name="OppositePropertyCallExp" eSuperTypes="#T-ocl-NavigationCallExp">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An additional attribute refParams lists all parameters of the referred operation except the return and out parameter(s)."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="SafeSourceCanBeNull UnsafeSourceCanNotBeNull"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Safe navigation is necessary when the source could be null."/>
      </eAnnotations>
      <details key="SafeSourceCanBeNull" value="(ownedSource &lt;> null) and isSafe implies not ownedSource.isNonNull()"/>
      <details key="UnsafeSourceCanNotBeNull" value="(ownedSource &lt;> null) and not isSafe implies ownedSource.isNonNull()"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-OppositePropertyCallExp-referredProperty" name="referredProperty" eType="#T-ocl-Property"
        resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-OrderedCollection" name="OrderedCollection" instanceClassName="java.util.Collection"
      abstract="true" interface="true">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="Collection"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;The OrderedCollection type provides the shared functionality of the OrderedSet and Sequence&#xA;collections for which the elements are ordered.&#xA;The common supertype of OrderedCollection is Collection.&#xA;"/>
    </eAnnotations>
    <eTypeParameters name="T"/>
    <eGenericSuperTypes eClassifier="#T-ocl-Collection">
      <eTypeArguments eTypeParameter="#//OrderedCollection/T"/>
    </eGenericSuperTypes>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-OrderedSet" name="OrderedSet" instanceClassName="org.eclipse.ocl.pivot.values.OrderedSet"
      abstract="true" interface="true">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="Collection"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;The OrderedSet is a Set, the elements of which are ordered.&#xA;It contains no duplicates. OrderedSet is itself an instance of the metatype OrderedSetType.&#xA;An OrderedSet is not a subtype of Set, neither a subtype of Sequence.&#xA;The common supertype of Sets and OrderedSets is Collection.&#xA;"/>
    </eAnnotations>
    <eTypeParameters name="T"/>
    <eGenericSuperTypes eClassifier="#T-ocl-OrderedCollection">
      <eTypeArguments eTypeParameter="#//OrderedSet/T"/>
    </eGenericSuperTypes>
    <eGenericSuperTypes eClassifier="#T-ocl-UniqueCollection">
      <eTypeArguments eTypeParameter="#//OrderedSet/T"/>
    </eGenericSuperTypes>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-OrderedSetType" name="OrderedSetType" eSuperTypes="#T-ocl-CollectionType"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-OrphanCompletePackage" name="OrphanCompletePackage" eSuperTypes="#T-ocl-CompletePackage">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The OrphanCompletePackage comprises each CompleteClass.for secondary types such as specializations."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Package" name="Package" eSuperTypes="#T-ocl-Namespace">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A package can have one or more profile applications to indicate which profiles have been applied. Because a profile is a package, it is possible to apply a profile not only to packages, but also to profiles.&#xA;Package specializes TemplateableElement and PackageableElement specializes ParameterableElement to specify that a package can be used as a template and a PackageableElement as a template parameter.&#xA;A package is used to group elements, and provides a namespace for the grouped elements."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Package-URI" name="URI" eType="#T-ocl-String">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Provides an identifier for the package that can be used for many purposes. A URI is the universally unique identification of the package following the IETF URI specification, RFC 2396 http://www.ietf.org/rfc/rfc2396.txt and it must comply with those syntax rules."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Package-importedPackages" name="importedPackages" ordered="false" upperBound="-1"
        eType="#T-ocl-Package" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Package-nsPrefix" name="nsPrefix" eType="#T-ocl-String"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Package-ownedClasses" name="ownedClasses" ordered="false" upperBound="-1"
        eType="#T-ocl-Class" containment="true" resolveProxies="false" eOpposite="#F-ocl-Class-owningPackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="References the packaged elements that are Types."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Package-ownedInstances" name="ownedInstances" ordered="false" upperBound="-1"
        eType="#T-ocl-InstanceSpecification" containment="true" resolveProxies="false" eOpposite="#F-ocl-InstanceSpecification-owningPackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The instance specification that owns this slot."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Package-ownedPackages" name="ownedPackages" ordered="false" upperBound="-1"
        eType="#T-ocl-Package" containment="true" resolveProxies="false" eOpposite="#F-ocl-Package-owningPackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="References the packaged elements that are Packages."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Package-ownedProfileApplications" name="ownedProfileApplications" ordered="false"
        upperBound="-1" eType="#T-ocl-ProfileApplication" containment="true" resolveProxies="false" eOpposite="#F-ocl-ProfileApplication-owningPackage">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="References the ProfileApplications that indicate which profiles have been applied to the Package."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Package-owningPackage" name="owningPackage" eType="#T-ocl-Package"
        resolveProxies="false" eOpposite="#F-ocl-Package-ownedPackages">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="References the Package that owns this Package."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Parameter" name="Parameter" eSuperTypes="#T-ocl-VariableDeclaration">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Parameter is a specification of an argument used to pass information into or out of an invocation of a BehavioralFeature.  Parameters can be treated as ConnectableElements within Collaborations."/>
