        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Model-ownedPackages" name="ownedPackages" ordered="false" upperBound="-1"
        eType="#T-ocl-Package" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Model-xmiidVersion" name="xmiidVersion" lowerBound="1" eType="#T-ocl-Integer"
        defaultValueLiteral="0"/>
