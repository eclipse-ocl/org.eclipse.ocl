  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Constraint" name="Constraint" eSuperTypes="#T-ocl-NamedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Constraint is a condition or restriction expressed in natural language text or in a machine readable language for the purpose of declaring some of the semantics of an Element or set of Elements."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="BooleanValued UniqueName"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="BooleanValued" value="ownedSpecification &lt;> null and ownedSpecification.type &lt;> null implies ownedSpecification.type = Boolean or ownedSpecification.type = OclVoid"/>
      <details key="UniqueName" value="true"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Constraint-constrainedElements" name="constrainedElements" upperBound="-1"
        eType="#T-ocl-Element" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The ordered set of Elements referenced by this Constraint."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Constraint-context" name="context" eType="#T-ocl-Namespace" changeable="false"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Constraint-isCallable" name="isCallable" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Constraint-ownedSpecification" name="ownedSpecification" lowerBound="1"
        eType="#T-ocl-LanguageExpression" containment="true" resolveProxies="false" eOpposite="#F-ocl-LanguageExpression-owningConstraint">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A condition that must be true when evaluated in order for the Constraint to be satisfied."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Constraint-owningPostContext" name="owningPostContext" eType="#T-ocl-Operation"
        resolveProxies="false" eOpposite="#F-ocl-Operation-ownedPostconditions"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Constraint-owningPreContext" name="owningPreContext" eType="#T-ocl-Operation"
        resolveProxies="false" eOpposite="#F-ocl-Operation-ownedPreconditions"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Constraint-owningState" name="owningState" eType="#T-ocl-State" resolveProxies="false"
        eOpposite="#F-ocl-State-ownedStateInvariant"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Constraint-owningTransition" name="owningTransition" eType="#T-ocl-Transition"
        resolveProxies="false" eOpposite="#F-ocl-Transition-ownedGuard"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Constraint-redefinedConstraints" name="redefinedConstraints" ordered="false"
        upperBound="-1" eType="#T-ocl-Constraint" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-DataType" name="DataType" eSuperTypes="#T-ocl-Class">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A DataType is a type whose instances are identified only by their value."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="BehavioralClassHasDistinctName BehavioralClassIsPrimitiveType BehavioralClassIsSuperClass"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;The behavioral class must be a superClass to ensure that its conformance provides the beahvioral functionaality., specifically Integer or Real.&#xA;"/>
      </eAnnotations>
      <details key="BehavioralClassHasDistinctName" value="behavioralClass &lt;> null implies superClasses->closure(superClasses)->forAll(b | b.name &lt;> name)"/>
      <details key="BehavioralClassIsPrimitiveType" value="behavioralClass &lt;> null implies behavioralClass.oclIsKindOf(PrimitiveType)"/>
      <details key="BehavioralClassIsSuperClass" value="behavioralClass &lt;> null implies superClasses->includes(behavioralClass)"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-DataType-behavioralClass" name="behavioralClass" eType="#T-ocl-Class"
        resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="An equivalent type, such as a PrimitiveType, that defines the conformance and evaluation behavior."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-DataType-isSerializable" name="isSerializable" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="true"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-DataType-value" name="value" lowerBound="1" eType="#T-ocl-String" changeable="false"
        defaultValueLiteral="">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The value pseudo-property accesses a String-valued representation of the DataType."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
