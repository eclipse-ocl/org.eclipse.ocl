      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Element-ownedComments" name="ownedComments" ordered="false" upperBound="-1"
        eType="#T-ocl-Comment" containment="true" resolveProxies="false" eOpposite="#F-ocl-Comment-owningElement">
