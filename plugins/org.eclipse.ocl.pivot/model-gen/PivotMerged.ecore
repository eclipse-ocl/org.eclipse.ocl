  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-OclInvalid" name="OclInvalid" instanceClassName="org.eclipse.ocl.pivot.InvalidType"
      eSuperTypes="#T-ocl-OclVoid">
