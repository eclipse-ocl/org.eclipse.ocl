  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Element" name="Element" eSuperTypes="#T-ocl-OclElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An Element is a constituent of a model. As such, it has the capability of owning other Elements."/>
    </eAnnotations>
    <eOperations name="allOwnedElements" ordered="false" upperBound="-1" eType="#T-ocl-Element">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The query allOwnedElements() gives all of the direct and indirect ownedElements of an Element."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="self->closure(oclContents()->selectByKind(Element))"/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eOperations>
    <eOperations name="getValue" eType="#T-ocl-Element">
      <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
        <details key="body" value="null"/>
      </eAnnotations>
      <eParameters name="stereotype" lowerBound="1" eType="#T-ocl-Type"/>
      <eParameters name="propertyName" lowerBound="1" eType="#T-ocl-String"/>
