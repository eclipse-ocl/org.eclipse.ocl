  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Feature" name="Feature" eSuperTypes="#T-ocl-TypedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A Feature declares a behavioral or structural characteristic of Classifiers."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="NameIsNotNull TypeIsNotInvalid TypeIsNotNull"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <details key="NameIsNotNull" value="name &lt;> null"/>
      <details key="TypeIsNotInvalid" value="type &lt;> OclInvalid"/>
      <details key="TypeIsNotNull" value="type &lt;> null"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Feature-implementation" name="implementation" eType="#T-ocl-LibraryFeature"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Feature-implementationClass" name="implementationClass" eType="#T-ocl-String"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Feature-isStatic" name="isStatic" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Specifies whether this Feature characterizes individual instances classified by the Classifier (false) or the Classifier itself (true)."/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-FeatureCallExp" name="FeatureCallExp" eSuperTypes="#T-ocl-CallExp">
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-FeatureCallExp-isPre" name="isPre" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-FinalState" name="FinalState" eSuperTypes="#T-ocl-State">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="A special kind of State, which, when entered, signifies that the enclosing Region has completed. If the enclosing Region is directly contained in a StateMachine and all other Regions in that StateMachine also are completed, then it means that the entire StateMachine behavior is completed."/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-IfExp" name="IfExp" eSuperTypes="#T-ocl-OCLExpression">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="ConditionTypeIsBoolean TypeIsNotInvalid"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel"/>
      <details key="ConditionTypeIsBoolean" value="self.ownedCondition.type = Boolean"/>
      <details key="TypeIsNotInvalid" value="type &lt;> OclInvalid"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-IfExp-isElseIf" name="isElseIf" lowerBound="1" eType="#T-ocl-Boolean"
        defaultValueLiteral="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="True if this IfExp corresponds to an 'elseif' in the OCL source, false if it corresponds to an 'if'. This attribute has no semantic significance; it merely supports more faithful reconstruction of the OCL source by a pretty printer."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-IfExp-ownedCondition" name="ownedCondition" lowerBound="1" eType="#T-ocl-OCLExpression"
        containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-IfExp-ownedElse" name="ownedElse" lowerBound="1" eType="#T-ocl-OCLExpression"
        containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-IfExp-ownedThen" name="ownedThen" lowerBound="1" eType="#T-ocl-OCLExpression"
        containment="true" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Import" name="Import" eSuperTypes="#T-ocl-NamedElement">
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Import-importedNamespace" name="importedNamespace" lowerBound="1" eType="#T-ocl-Namespace"
        resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-Import-xmiidVersion" name="xmiidVersion" lowerBound="1" eType="#T-ocl-Integer"
        defaultValueLiteral="0"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-InstanceSpecification" name="InstanceSpecification" eSuperTypes="#T-ocl-NamedElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="An InstanceSpecification is a model element that represents an instance in a modeled system. An InstanceSpecification can act as a DeploymentTarget in a Deployment relationship, in the case that it represents an instance of a Node. It can also act as a DeployedArtifact, if it represents an instance of an Artifact."/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-InstanceSpecification-classes" name="classes" ordered="false" upperBound="-1"
        eType="#T-ocl-Class" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The Classifier or Classifiers of the represented instance. If multiple Classifiers are specified, the instance is classified by all of them."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-InstanceSpecification-ownedSlots" name="ownedSlots" ordered="false"
        upperBound="-1" eType="#T-ocl-Slot" containment="true" resolveProxies="false" eOpposite="#F-ocl-Slot-owningInstance">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A Slot giving the value or values of a StructuralFeature of the instance. An InstanceSpecification can have one Slot per StructuralFeature of its Classifiers, including inherited features. It is not necessary to model a Slot for every StructuralFeature, in which case the InstanceSpecification is a partial description."/>
      </eAnnotations>
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-InstanceSpecification-ownedSpecification" name="ownedSpecification"
        eType="#T-ocl-LanguageExpression" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="A specification of how to compute, derive, or construct the instance."/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-InstanceSpecification-owningPackage" name="owningPackage" eType="#T-ocl-Package"
        resolveProxies="false" eOpposite="#F-ocl-Package-ownedInstances"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EDataType" xmi:id="T-ocl-Integer" name="Integer" instanceClassName="org.eclipse.ocl.pivot.values.IntegerValue">
    <eAnnotations source="http://www.omg.org/ocl">
      <details key="ClassGroup" value="Primitive"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="&#xA;The standard type Integer represents the mathematical concept of integer.&#xA;Integer is itself an instance of the metatype PrimitiveType (from UML).&#xA;"/>
    </eAnnotations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-IntegerLiteralExp" name="IntegerLiteralExp" eSuperTypes="#T-ocl-NumericLiteralExp">
    <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
      <details key="documentation" value="The type of the if expression is the most common supertype of the else and then expressions."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="TypeIsInteger"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The type of an integer Literal expression is the type Integer."/>
      </eAnnotations>
      <details key="TypeIsInteger" value="self.type = Integer"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EAttribute" xmi:id="F-ocl-IntegerLiteralExp-integerSymbol" name="integerSymbol" lowerBound="1"
        eType="#T-ocl-Integer"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-InvalidLiteralExp" name="InvalidLiteralExp" eSuperTypes="#T-ocl-LiteralExp"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-InvalidType" name="InvalidType" eSuperTypes="#T-ocl-OclElement #T-ocl-Class">
    <eOperations name="allInstances" ordered="false" upperBound="-1" eType="#T-ocl-OclSelf">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="&#xA;Returns oclText[invalid].&#xA;"/>
      </eAnnotations>
    </eOperations>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-IterableType" name="IterableType" eSuperTypes="#T-ocl-DataType"/>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-IterateExp" name="IterateExp" eSuperTypes="#T-ocl-LoopExp #T-ocl-ReferringElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="BodyTypeConformsToResultType OneInitializer SafeIteratorIsRequired SafeSourceCanBeNull TypeIsResultType UnsafeSourceCanNotBeNull"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Safe navigation is necessary when an iterator cannot be null and the source collection is not null-free."/>
      </eAnnotations>
      <details key="BodyTypeConformsToResultType" value="true"/>
      <details key="OneInitializer" value="true"/>
      <details key="SafeIteratorIsRequired" value="isSafe implies ownedIterators->forAll(isRequired)"/>
      <details key="SafeSourceCanBeNull" value="isSafe implies not&#xA;&#x9;let sourceType = ownedSource?.type in&#xA;&#x9;if sourceType.oclIsKindOf(MapType) then sourceType.oclAsType(MapType).keysAreNullFree else sourceType.oclAsType(CollectionType).isNullFree endif&#xA;"/>
      <details key="TypeIsResultType" value="true"/>
      <details key="UnsafeSourceCanNotBeNull" value="(not isSafe and ownedIterators->exists(isRequired)) implies&#xA;&#x9;let sourceType = ownedSource?.type in&#xA;&#x9;if sourceType.oclIsKindOf(MapType) then sourceType.oclAsType(MapType).keysAreNullFree else sourceType.oclAsType(CollectionType).isNullFree endif&#xA;&#xA;"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-IterateExp-ownedBodies" name="ownedBodies" lowerBound="1" upperBound="-1"
        eType="#T-ocl-OCLExpression" containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-IterateExp-ownedResult" name="ownedResult" eType="#T-ocl-Variable"
        containment="true" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-Iteration" name="Iteration" eSuperTypes="#T-ocl-Operation">
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Iteration-ownedAccumulator" name="ownedAccumulator" eType="#T-ocl-Parameter"
        containment="true" resolveProxies="false"/>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-Iteration-ownedIterators" name="ownedIterators" upperBound="-1" eType="#T-ocl-Parameter"
        containment="true" resolveProxies="false">
      <eAnnotations source="http://www.eclipse.org/OCL/Collection">
        <details key="nullFree" value="true"/>
      </eAnnotations>
    </eStructuralFeatures>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-IteratorExp" name="IteratorExp" eSuperTypes="#T-ocl-LoopExp #T-ocl-ReferringElement">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="AnyBodyTypeIsBoolean AnyHasOneIterator AnyTypeIsSourceElementType ClosureBodyElementTypeIsIteratorType ClosureBodyTypeIsConformanttoIteratorType ClosureElementTypeIsSourceElementType ClosureHasOneIterator ClosureResultElementTypeIsIteratorType ClosureSourceElementTypeIsBodyElementType ClosureTypeIsUniqueCollection CollectElementTypeIsFlattenedBodyType CollectTypeIsUnordered IteratorTypeIsSourceElementType IteratorTypeIsSourceKeyType SafeIteratorIsRequired SafeSourceCanBeNull SortedByElementTypeIsSourceElementType SortedByIsOrderedIfSourceIsOrdered SortedByIteratorTypeIsComparable UnsafeSourceCanNotBeNull"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Safe navigation is necessary when an iterator cannot be null and the source collection is not null-free."/>
      </eAnnotations>
      <details key="AnyBodyTypeIsBoolean" value="true"/>
      <details key="AnyHasOneIterator" value="true"/>
      <details key="AnyTypeIsSourceElementType" value="true"/>
      <details key="ClosureBodyElementTypeIsIteratorType" value="name = 'closure' implies&#xA;&#x9;let bodyElementType = if ownedBody.type.oclIsKindOf(CollectionType) then ownedBody.type.oclAsType(CollectionType).elementType elseif ownedBody.type.oclIsKindOf(MapType) then ownedBody.type.oclAsType(MapType).keyType else ownedBody.type endif in &#xA;&#x9;let iteratorType = ownedIterators->at(1).type in&#xA;&#x9;bodyElementType?.conformsTo(iteratorType)&#xA;&#xA;"/>
      <details key="ClosureBodyTypeIsConformanttoIteratorType" value="true"/>
      <details key="ClosureElementTypeIsSourceElementType" value="true"/>
      <details key="ClosureHasOneIterator" value="true"/>
      <details key="ClosureResultElementTypeIsIteratorType" value="&#xA;&#x9;name = 'closure' implies&#xA;&#x9;&#x9;let resultElementType = type.oclAsType(CollectionType).elementType in &#xA;&#x9;&#x9;let iteratorType = ownedIterators->at(1).type in&#xA;&#x9;&#x9;iteratorType?.conformsTo(resultElementType)&#xA;&#xA;"/>
      <details key="ClosureSourceElementTypeIsBodyElementType" value="true"/>
      <details key="ClosureTypeIsUniqueCollection" value="name = 'closure' implies&#xA;if ownedSource?.type?.oclIsKindOf(SequenceType) or ownedSource?.type.oclIsKindOf(OrderedSetType) then&#xA;type.oclIsKindOf(OrderedSetType)&#xA;else&#xA;type.oclIsKindOf(SetType)&#xA;endif&#xA;&#xA;"/>
      <details key="CollectElementTypeIsFlattenedBodyType" value="name = 'collect' implies&#xA;type.oclAsType(CollectionType).elementType = ownedBody.type?.flattenedType()&#xA;&#xA;"/>
      <details key="CollectTypeIsUnordered" value="name = 'collect' implies&#xA;if ownedSource?.type.oclIsKindOf(SequenceType) or ownedSource?.type.oclIsKindOf(OrderedSetType) then&#xA;type.oclIsKindOf(SequenceType)&#xA;else&#xA;type.oclIsKindOf(BagType)&#xA;endif&#xA;&#xA;"/>
      <details key="IteratorTypeIsSourceElementType" value="let sourceType = ownedSource?.type in sourceType.oclIsKindOf(CollectionType) implies&#xA;    let sourceElementType = sourceType.oclAsType(CollectionType).elementType in&#xA;    self.ownedIterators->forAll(p | sourceElementType.conformsTo(p.type))&#xA;"/>
      <details key="IteratorTypeIsSourceKeyType" value="let sourceType = ownedSource?.type in sourceType.oclIsKindOf(MapType) implies&#xA;    let sourceKeyType = sourceType.oclAsType(MapType).keyType in&#xA;    self.ownedIterators->forAll(p | sourceKeyType.conformsTo(p.type))&#xA;"/>
      <details key="SafeIteratorIsRequired" value="isSafe implies ownedIterators->forAll(isRequired)"/>
      <details key="SafeSourceCanBeNull" value="isSafe implies not&#xA;&#x9;let sourceType = ownedSource?.type in&#xA;&#x9;if sourceType.oclIsKindOf(MapType) then sourceType.oclAsType(MapType).keysAreNullFree else sourceType.oclAsType(CollectionType).isNullFree endif&#xA;"/>
      <details key="SortedByElementTypeIsSourceElementType" value="name = 'sortedBy' implies&#xA;type.oclAsType(CollectionType).elementType =&#xA;ownedSource?.type.oclAsType(CollectionType).elementType&#xA;&#xA;"/>
      <details key="SortedByIsOrderedIfSourceIsOrdered" value="name = 'sortedBy' implies&#xA;if ownedSource?.type.oclIsKindOf(SequenceType) or ownedSource?.type.oclIsKindOf(BagType) then&#xA;type.oclIsKindOf(SequenceType)&#xA;else&#xA;type.oclIsKindOf(OrderedSetType)&#xA;endif&#xA;&#xA;"/>
      <details key="SortedByIteratorTypeIsComparable" value="true"/>
      <details key="UnsafeSourceCanNotBeNull" value="(not isSafe and ownedIterators->exists(isRequired)) implies&#xA;&#x9;let sourceType = ownedSource?.type in&#xA;&#x9;if sourceType.oclIsKindOf(MapType) then sourceType.oclAsType(MapType).keysAreNullFree else sourceType.oclAsType(CollectionType).isNullFree endif&#xA;&#xA;"/>
    </eAnnotations>
    <eStructuralFeatures xsi:type="ecore:EReference" xmi:id="F-ocl-IteratorExp-ownedBody" name="ownedBody" lowerBound="1" eType="#T-ocl-OCLExpression"
        containment="true" resolveProxies="false"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" xmi:id="T-ocl-IteratorVariable" name="IteratorVariable" eSuperTypes="#T-ocl-Variable">
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="HasNoInitializer"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="Iterator variable has no initializer."/>
      </eAnnotations>
      <details key="HasNoInitializer" value="ownedInit = null"/>
    </eAnnotations>
  </eClassifiers>
