      <details key="documentation" value="FeatureCallExp&#xA;No additional well-formedness rules."/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore">
      <details key="constraints" value="OneCallOrOneSend TargetIsNotACollection"/>
    </eAnnotations>
    <eAnnotations source="http://www.eclipse.org/emf/2002/Ecore/OCL/Pivot">
      <eAnnotations source="http://www.eclipse.org/emf/2002/GenModel">
        <details key="documentation" value="The target of an OCL message cannot be a collection."/>
      </eAnnotations>
      <details key="OneCallOrOneSend" value="ownedCalledOperation->size() + ownedSentSignal->size() = 1"/>
      <details key="TargetIsNotACollection" value="not ownedTarget.type.oclIsKindOf(CollectionType)"/>
